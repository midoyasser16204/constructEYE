# Copy this file to `.env` in the repo root and fill in your real values.
# Never commit `.env` or Firebase service-account JSON files to GitHub.

# --- Firestore / Firebase ---
CONSTRUCT_EYE_PROJECT_ID=0
FIREBASE_SERVICE_ACCOUNT=/path/to/your-firebase-service-account.json
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com

# --- Site identity ---
SITE_NAME=YOUR_SITE_NAME
DEVICE_ID=
STREAM_LINK=http://YOUR_PI_IP:8081/mjpeg

# --- Optional fixed location (omit to auto-detect from GPS/IP on the Pi) ---
DEVICE_LOCATION=YOUR_CITY, YOUR_COUNTRY
DEVICE_LATITUDE=
DEVICE_LONGITUDE=
FALLBACK_LATITUDE=0.0
FALLBACK_LONGITUDE=0.0
FALLBACK_CITY=YOUR_CITY
FALLBACK_COUNTRY=YOUR_COUNTRY

# --- Moondream vision API (progress reports only) ---
MOONDREAM_API_KEY=YOUR_MOONDREAM_API_KEY

# --- Progress report paths ---
CONSTRUCT_EYE_IMAGE_DIR=./sample-site-images
CONSTRUCT_EYE_GUI_ICON=./assets/branding/construct_eye_logo.ico
CONSTRUCT_EYE_GUI_LOGO=./assets/branding/construct_eye_logo.png
CONSTRUCT_EYE_PDF_LOGO=./assets/branding/construct_eye_logo.png
